{
  "name": "ollama-desktop",
  "version": "1.0.0",
  "description": "Ollama LLM可視化デスクトップアプリ - ドット絵キャラクターでLLMを擬人化",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "dev":   "electron . --dev"
  },
  "dependencies": {
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^28.0.0"
  },
  "build": {
    "appId": "com.ollama.desktop",
    "productName": "Ollama Desktop",
    "files": ["main/**", "preload/**", "renderer/**"],
    "mac":   { "target": "dmg",     "icon": "assets/icon.icns" },
    "win":   { "target": "nsis",    "icon": "assets/icon.ico"  },
    "linux": { "target": "AppImage","icon": "assets/icon.png"  }
  }
}
